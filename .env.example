# Public address users and clients will use. Set HTTPS in production.
APP_BASE_URL=http://localhost:8080

# Optional version string baked into the image and shown in Settings.
NYASUB_VERSION=1.0.0

# Image used by Compose. Set this to ghcr.io/<owner>/<repo>:latest when
# deploying the image published by the GitHub Actions workflow.
NYASUB_IMAGE=nyasub:latest

# Port published on the Docker host.
APP_PORT=8080

# Container listen address. Docker Compose fixes this to 0.0.0.0:8080.
APP_LISTEN=0.0.0.0:8080

# Optional. If empty, a random secret is generated once and persisted in /data.
# At least 32 characters when set. Example: openssl rand -base64 48
APP_SESSION_SECRET=

APP_LOG_LEVEL=info

# Optional. Set to your reverse proxy IP/CIDR so rate limiting sees client IPs.
APP_TRUSTED_PROXIES=

TZ=UTC
